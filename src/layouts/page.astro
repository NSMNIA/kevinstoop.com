---
import { Font } from "astro:assets";
import "../styles/global.css";
import Footer from "../components/footer.astro";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  robots?: string;
}

const site = Astro.site?.origin ?? "https://kevinstoop.com";

const {
  title = "Kevin Stoop",
  description = "I'm Kevin, a software engineer passionate about frontend development, performance, and bringing thoughtful digital products and experiences to life.",
  canonical = site,
  robots,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <Font cssVariable="--font-sans" preload={[{ style: "normal", subset: "latin" }]} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Kevin Stoop" />
    <link rel="canonical" href={canonical} />
    {robots ? (
      <meta name="robots" content={robots} />
    ) : (
      <meta
        name="googlebot"
        content="index, follow, max-video-preview:-1, max-image-preview:large, max-snippet:-1"
      />
    )}
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
    <meta name="color-scheme" content="light" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/favicon.png`} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:image:alt" content="Kevin Stoop — Software Engineer" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kevin Stoop" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@kevinstoop_" />
    <meta name="twitter:creator" content="@kevinstoop_" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kevin Stoop",
        "url": "https://kevinstoop.com",
        "email": "hello@kevinstoop.com",
        "jobTitle": "Software Engineer",
        "sameAs": [
          "https://github.com/NSMNIA/",
          "https://www.linkedin.com/in/kevinstoop/",
          "https://x.com/kevinstoop_"
        ]
      }
    </script>
  </head>
  <body class="mx-auto flex min-h-screen max-w-140 flex-col px-[clamp(1.25rem,6vw,3.75rem)] pt-[calc(var(--head-top)+0.188rem)] pb-[clamp(1.75rem,5vh,2.75rem)]">
    <main class="flex flex-col gap-4">
      <slot />
    </main>
    <Footer />
  </body>
</html>
