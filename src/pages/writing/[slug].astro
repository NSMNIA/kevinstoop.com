---
import { render, type CollectionEntry } from "astro:content";
import Page from "../../layouts/page.astro";
import { formatDate } from "../../lib/date";
import { getPosts } from "../../lib/posts";
import { CornerUpLeft } from "@lucide/astro";

export async function getStaticPaths() {
  const posts = await getPosts();

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonical = new URL(`/writing/${post.id}`, Astro.site ?? "https://kevinstoop.com").href;
const modified = post.data.updatedDate ?? post.data.pubDate;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: modified.toISOString(),
  author: {
    "@type": "Person",
    name: "Kevin Stoop",
    url: "https://kevinstoop.com",
  },
  mainEntityOfPage: canonical,
};
---

<Page
  title={`${post.data.title} — Kevin Stoop`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:modified_time" content={modified.toISOString()} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
    />
  </Fragment>
  <p data-fade>
    <p data-fade>
      <a
        class="relative inline-flex items-center gap-1 text-xxs text-muted decoration-primary ring-offset-background outline-hidden transition-colors hover:brightness-120 focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        href="/writing"
      >
        <CornerUpLeft class="size-3" aria-hidden="true" />
        Writing
      </a>
    </p>
  </p>
  <h1 class="text-balance wght-500 dark:wght-450" data-fade>
    {post.data.title}
  </h1>
  <p class="text-xxs text-muted" data-fade data-fade-kind="body">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    {post.data.updatedDate && (
      <>
        {" · Updated "}
        <time datetime={post.data.updatedDate.toISOString()}>
          {formatDate(post.data.updatedDate)}
        </time>
      </>
    )}
  </p>
  <div class="entry" data-fade data-fade-kind="body">
    <Content />
  </div>
</Page>
