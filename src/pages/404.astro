---
import Page from "../layouts/page.astro";
---

<Page title="Page is not found — Kevin Stoop" robots="noindex">
  <h1 class="text-balance wght-500" data-fade>
    Well, this is awkward.
  </h1>
  <p class="leading-relaxed text-pretty text-muted wght-450" data-fade data-fade-kind="body">
    The page you are looking for is not here. Maybe it was moved or deleted.
  </p>
  <div data-fade data-fade-kind="body">
    <a
      class="inline-flex items-center gap-2 text-foreground decoration-primary hover:underline hover:underline-offset-2"
      href="/"
    >
      Back home
    </a>
  </div>
</Page>
